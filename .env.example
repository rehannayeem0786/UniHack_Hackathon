# ---------------------------------------------------------------
# UniHack 2026 - Product Intelligence Engine
# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------

# Which provider to try first: "groq" or "gemini".
# The other one is used automatically as a fallback.
LLM_PROVIDER=groq

# --- Groq (primary) -> https://console.groq.com/keys ---
# Preferred because the free tier allows thousands of requests per day.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
# Extra models to fall back to, in order, when one hits its quota.
# Discover what your key can use with: python scripts/list_models.py
GROQ_MODEL_CHAIN=

# --- Gemini (fallback) -> https://aistudio.google.com/apikey ---
# Note: the free Gemini tier allows only 20 requests per model per day,
# which is why Groq is the primary provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_CHAIN=

# --- Pipeline tuning ---
# Parallel worker threads for enrichment
MAX_CONCURRENCY=6
# Records per LLM request; batching keeps runs inside free-tier limits
BATCH_SIZE=8
# Retry attempts per LLM call before falling back to deterministic logic
LLM_MAX_RETRIES=3
# Cache LLM responses to disk so re-runs are free.
# `data/cache/` is committed to the repo, so every deploy ships WITH the best
# previously computed answers pre-loaded: fast, accurate, and no paid disk.
ENABLE_LLM_CACHE=true
CACHE_DIR=data/cache

# --- Manufacturer source retrieval ---
# Needs no API key. The pipeline reads only from a manufacturer's own site and
# documents; marketplaces and distributor sites are refused by policy, and a
# search index is used solely to locate a first-party URL, never as a data source.
# Set to false for a fully offline run - anything fetched before still replays
# from the cache.
WEB_ENABLED=true
WEB_CACHE=true
WEB_TIMEOUT=20
WEB_CONCURRENCY=8
# Politeness: minimum gap between two requests to the same host, and to the
# search index. Lowering these will get you rate-limited, not served faster.
WEB_DELAY_SECONDS=0.6
WEB_SEARCH_DELAY=1.2
WEB_RESPECT_ROBOTS=true
# Documents read per product, and the character budget of source material handed
# to the model. Specification pairs are always included first; see
# EvidenceBundle.as_prompt_context for why the budget is deliberately small.
WEB_MAX_DOCUMENTS=3
WEB_CONTEXT_CHARS=3500

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Browser origins the API will answer cross-origin, comma-separated. The local
# defaults keep a Vite dev server working. When the frontend is hosted elsewhere
# (e.g. Vercel) and points at this API, add its origin:
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://my-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
